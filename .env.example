# X4 BEAST configuration (Beast Mode v0.2.0)
# Never commit real credentials.

X4_HOST=127.0.0.1
X4_PORT=8787
X4_DB=./data/x4.db
X4_AUDIT_JSONL=./data/audit.jsonl

# Beast Mode controls
X4_AUTONOMY_LEVEL=1          # 0=Observe, 1=Assist, 2=Governed Autopilot, 3=Never
X4_AUTOFIX_ENABLED=true      # only applies inside policy bounds
X4_PREFER_LOCAL=true         # hybrid: try local first, then cloud fallback

# Local (preferred)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud fallback (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=X4-BEAST

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
